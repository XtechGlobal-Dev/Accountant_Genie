# pnpm settings that must apply on pnpm 10.
#
# pnpm only began reading settings from pnpm-workspace.yaml in 10.6. On 10.0-10.5
# the keys in that file are silently ignored — which is how an install once
# flipped autoInstallPeers back on, gave server/ its own copy of next, and
# defeated the single-React-identity guard CLAUDE.md §7 depends on. .npmrc is
# read by every version, so the settings that matter live here.

# next and react are peers of @ledgerly/server, provided by the root package.
# Auto-installing them would put a second copy in server/node_modules and two
# module identities in one process.
auto-install-peers=false
