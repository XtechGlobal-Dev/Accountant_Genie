# next is a peer dependency of @ledgerly/server, provided by the root package.
#
# npm satisfies a workspace's peer from the root when the version matches, so
# one copy of next and react exists in the process rather than two. That single
# module identity is what CLAUDE.md §7 depends on — if an install ever puts a
# second copy under server/node_modules, that is the thing to look at first.
#
# Check with:  npm ls react next
install-links=false
