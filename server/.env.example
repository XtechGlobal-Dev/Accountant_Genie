# ---------------------------------------------------------------------------
# Neon (serverless Postgres)
#
# Neon gives you TWO connection strings. Both are needed:
#
#   DATABASE_URL        -> POOLED   (host contains "-pooler"). Used by the app.
#   DIRECT_DATABASE_URL -> DIRECT   (no "-pooler"). Used by prisma db push,
#                                   migrate and introspect, which take advisory
#                                   locks that a connection pooler breaks.
#
# Keep ?sslmode=verify-full on both — Neon refuses unencrypted connections.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ledgerly?sslmode=verify-full"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/ledgerly?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Pepper for one-time codes. Required in production; any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Password the seed gives the demo owner (demo@meridian.test).
DEMO_PASSWORD="Ledgerly-demo-2026"
# Sign in with Google (OAuth 2.0 web client). Redirect URI: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email — Resend over HTTP. Without both, messages go to the server log in
# development. In production (NODE_ENV=production) no body is ever logged:
# the log says a message was not sent and to whom (masked), nothing more.
#
# MAIL_FROM must be an address on a domain verified at resend.com/domains.
# Resend's shared sender `onboarding@resend.dev` delivers ONLY to the Resend
# account owner's own address — every other recipient is refused with 403, so
# sign-up codes, feed invitations and support mail all fail silently for real
# users. Verify a domain before testing the flows with anyone else's address.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Accountant Genie <no-reply@example.com>"
# Staging escape hatch. Outside production every outbound message is written to
# the server log in full — sign-in codes, temporary passwords, bank feed links —
# so local development needs no mail provider at all. With NODE_ENV=production
# that stops: a body is a working credential, and a production log is shared,
# retained and shipped elsewhere.
#
# Set this to 1 on a staging environment whose mail is not configured yet, so a
# tester can read their own code out of the log instead of being stuck at the
# code entry screen. Everything it prints is a live credential visible to anyone
# with log access, so it belongs on staging with throwaway accounts and NEVER on
# an environment holding a real firm's books. Clear it once mail works. Only the
# exact value 1 enables it.
MAIL_DEBUG_LOG_BODIES=""
# Same bargain as the line above, aimed one step further out: the code is
# handed to the BROWSER that asked for it, so a tester reads it from DevTools
# without needing server log access. Use it when the log is not reachable
# either — a deployed staging box, a demo for someone else.
#
# While this is on, the six-digit step protects nothing: whoever knows the
# password can read the code off their own screen. The account is worth its
# password and no more. The code screen says so in a banner, deliberately.
#
# It also refuses to work once a mail provider is configured, so it cannot
# outlive its reason. Only the exact value 1 enables it. NEVER on an
# environment holding a real firm's books.
MAIL_DEBUG_ECHO_CODE=""
# Where the in-app Support form delivers. Defaults to a placeholder inbox; with
# no mail provider the message is written to the server log.
SUPPORT_EMAIL=""

# ---------------------------------------------------------------------------
# AI classification tier
# ---------------------------------------------------------------------------
# Anthropic - the provider this product is built on. Required for the AI tier.
# The rules + memory tiers run without it; MockProvider runs the whole pipeline offline.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-opus-5, which is what the classifier is tuned for.
ANTHROPIC_MODEL=""

# OpenAI - an alternative behind the same provider interface. It is selected
# only when ANTHROPIC_API_KEY is empty AND both of the two below are set.
OPENAI_API_KEY=""
# Model id. Run `npm run ai:models` once the key is set to list what your account can use.
OPENAI_MODEL=""

# ---------------------------------------------------------------------------
# Reconciliation thresholds (configuration, never constants in code)
# ---------------------------------------------------------------------------
# Transactions per AI request. 40 is a good balance of cost and latency.
RECONCILE_BATCH_SIZE=40
# Below this confidence an AI answer is treated as Unknown and routed to review.
RECONCILE_CONFIDENCE_FLOOR=0.75
# At or above this, with low risk, a coding is ready to accept without a look.
RECONCILE_AUTO_CONFIDENCE=0.95
# An absolute amount at or above this (cents) is high risk regardless of confidence.
RECONCILE_HIGH_RISK_CENTS=500000
# A supplier nobody has reviewed for the client is high risk from this amount (cents).
# Applies to AI-tier codings only — a rule or memory hit is the firm's own policy.
# $2,500: "Ready" still means a person clicks Accept, and at $500 every first-time
# supplier on a new client went to review, so a fresh client never had a Ready row.
RECONCILE_NOVELTY_RISK_CENTS=250000
# How many accounts one run may create from AI proposals, after the resolver has
# found nothing equivalent in the chart. The rest of a run's proposals go to
# review with the proposal attached. 0 disables creation entirely.
RECONCILE_MAX_NEW_ACCOUNTS=5
# The share of transactions memory and rules should resolve before any AI call
# (0-1). A run below it is flagged in its stats and the server log.
RECONCILE_PRE_AI_TARGET=0.6
# The AI reviewer: a second call, with its own prompt and the client's signed-off
# history, that challenges every coding the classifier proposed. An AGREE at or
# above RECONCILE_REVIEWER_CONFIDENCE clears the classifier's confidence gap, a
# first-time merchant and a newly created account, so the row is Ready to accept.
# A large amount, a balance-sheet posting and a coding that contradicts a person's
# earlier decision still wait for a person whatever the reviewer says.
# Set RECONCILE_REVIEWER=off to route on the classifier alone, as before.
RECONCILE_REVIEWER=on
RECONCILE_REVIEWER_CONFIDENCE=0.95

# ---------------------------------------------------------------------------
# Background jobs.
#
# A job is dispatched by the first of these that applies:
#
#   REDIS_URL set          BullMQ. Run `npm run worker` alongside the app.
#   A serverless host      An HTTP hand-off to /api/jobs/run, which finishes
#                          the job in an invocation of its own. Detected from
#                          VERCEL_URL, or forced with JOB_RUNNER_URL.
#   Neither                An in-process timer. The local default.
#
# On Vercel the first two lines matter: a timer does NOT survive the response
# there, so without the hand-off an import dies part-way through coding and
# the job sits RUNNING until it is reaped.
# ---------------------------------------------------------------------------
REDIS_URL=""
WORKER_CONCURRENCY=2

# Only set these to override the defaults.
#   JOB_RUNNER_URL     The origin to call back into, e.g. https://app.example.com.
#                      Defaults to this deployment (VERCEL_URL). Set it when the
#                      deployment URL is not reachable from the function itself.
#   JOB_RUNNER_SECRET  Authorises that call. Defaults to AUTH_SECRET, which is
#                      already set and already identical across the deployment,
#                      so there is normally nothing to configure.
JOB_RUNNER_URL=""
JOB_RUNNER_SECRET=""

# ---------------------------------------------------------------------------
# Object storage for uploaded statements — S3 or Cloudflare R2.
# Without S3_BUCKET, files are kept under ./storage on local disk.
# ---------------------------------------------------------------------------
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Billing — Stripe Checkout. Without these, plan choice is recorded, nothing charged.
# Webhook endpoint: <origin>/api/stripe/webhook
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CORE_MONTHLY=""
STRIPE_PRICE_CORE_YEARLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_YEARLY=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_YEARLY=""

# ---------------------------------------------------------------------------
# Live bank feeds — Fiskil, our accredited data recipient under the CDR.
#
# Accountant Genie is not itself CDR-accredited; Fiskil is, and receives the data on
# the client's authority. Without these keys the feed UI says so plainly, feed
# requests are still recorded, and statements are imported by upload.
#
# console.fiskil.com > Settings > API Keys. The secret is shown ONCE.
# Sandbox is free and unmetered — use it until the flow is proven.
# ---------------------------------------------------------------------------
FISKIL_CLIENT_ID=""
FISKIL_CLIENT_SECRET=""
FISKIL_BASE_URL="https://api.fiskil.com"
# v1 | v2 | v3 — sent as the X-Fiskil-Version header on every request. The
# "/v1/" in Fiskil's URLs is a fixed namespace shared by all versions, NOT the
# version itself, so this is the only thing that selects the API version.
FISKIL_API_VERSION="v3"

# OPTIONAL, and independent of the key pair above: the key pair authorises
# OUTBOUND calls, this verifies INBOUND webhooks.
#
# Issued as base64 when you register an endpoint at Settings > Webhooks, which
# needs a publicly reachable URL — so leave it blank in local development and
# use "Sync now" to pull data. Without it, POST /api/webhooks/fiskil rejects
# every delivery with 503 rather than trusting an unauthenticated payload.
#
# Subscribe the endpoint to at least:
#   consent.received, consent.revoked,
#   banking.transactions.sync.completed,
#   banking.transactions.recent.sync.completed
# Event subscriptions CANNOT be changed after creation — only the URL can.
#
# Fiskil delivers from these IPs, if a firewall needs them allowlisted:
#   35.244.81.128  34.40.183.9  35.197.175.34  34.87.253.122
# Retries: up to 5 attempts, 1-10 minutes apart, then the event is DISCARDED.
FISKIL_WEBHOOK_SECRET=""

# Where Fiskil returns the client after the hosted consent flow. The Link SDK
# does not use these, but the API accepts them, so the same auth session works
# either way. Leave blank to use the SDK only.
FISKIL_REDIRECT_URI=""
FISKIL_CANCEL_URI=""
