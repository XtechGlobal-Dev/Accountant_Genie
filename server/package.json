{
  "name": "@ledgerly/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:check": "tsx scripts/check-connection.ts",
    "db:constraints": "prisma db execute --file prisma/sql/constraints.sql",
    "db:purge-demo": "tsx scripts/purge-demo.ts",
    "generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "bootstrap": "prisma generate && npm run db:push && npm run db:seed",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "ai:models": "tsx scripts/list-models.ts",
    "ai:golden": "tsx --conditions=react-server scripts/ai-golden.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:idor": "vitest run --config vitest.idor.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "fiskil:check": "tsx --conditions=react-server scripts/check-fiskil.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:sync-accounts": "tsx --conditions=react-server scripts/sync-accounts.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@aws-sdk/client-s3": "3.1127.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "bullmq": "5.81.4",
    "ioredis": "5.11.1",
    "openai": "7.10.0",
    "papaparse": "5.5.3",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "server-only": "0.0.1",
    "stripe": "20.4.1",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "next": "16.3.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/papaparse": "5.3.16",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
