{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],

    // Both trees keep their historic import forms: @/server and @/shared resolve
    // into server/src, @/ui and @/features into app/. No source file changed.
    "paths": {
      "@/server/*": ["./server/src/*"],
      "@/shared/*": ["./server/src/shared/*"],
      "@/generated/*": ["./server/generated/*"],
      "@/ui/*": ["./app/_ui/*"],
      "@/features/*": ["./app/_features/*"],
      "@/app/*": ["./app/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "proxy.ts",
    "next.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "server/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "server/generated", "docs"]
}
